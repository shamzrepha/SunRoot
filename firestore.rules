rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    // Admin status can only ever be set via the Firebase console (Admin SDK
    // bypasses these rules entirely) — there is deliberately no path here
    // for a client, even an existing admin, to grant isAdmin to anyone.
    function isAdminUser() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // New accounts are never admin, regardless of what a crafted client
      // request claims — isAdmin can only be granted via the Firebase console.
      allow create: if isSelf(uid)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      // A user may update their own profile (name, bio, etc.) freely, but
      // never their role, tag, or admin flag.
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.studentTag == resource.data.studentTag
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
      // Only an admin can remove a profile outright, and never their own by
      // this path (self-deletion isn't something the admin panel offers).
      allow delete: if isAdminUser() && !isSelf(uid);
    }

    match /classrooms/{classroomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      // Owner can edit anything; any signed-in user can only touch studentIds
      // (covers self-join on public classes and leaving/removal).
      allow update: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds'])
      );
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid || resource.data.teacherId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.studentUid == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids;
      allow update: if isSignedIn(); // MVP: any signed-in user can update shared state
    }

    match /classSuggestions/{suggestionId} {
      allow read: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdminUser());
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.status == 'new';
      allow update: if isAdminUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }

    match /progressSnapshots/{snapshotId} {
      // Same low bar as `users`: any signed-in person can read it (teachers
      // need to see any student's summary without a per-classroom check in
      // rules). Doc id is `{classroomId}_{uid}`, not a bare uid, so the
      // write check matches on the document's own `uid` field instead of
      // the path segment — only the student themselves can ever write it.
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /friendRequests/{requestId} {
      // Only the two people involved can see a request at all.
      allow read: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.status == 'pending';
      // Only the recipient can respond, and only the status/timestamp — not
      // who it's from/to, which would let someone hijack another pair's request.
      allow update: if isSignedIn()
        && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt']);
    }

    match /blocks/{blockId} {
      // Same low bar as users/progressSnapshots — whether a block exists
      // isn't sensitive enough to warrant per-document rule complexity, and
      // that complexity has a real footgun here: a rule that inspects
      // resource.data on a *nonexistent* doc denies rather than just
      // returning "not found," which would break every "am I blocked?"
      // check for the (extremely common) case where no block exists yet.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.blockerUid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.blockerUid == request.auth.uid;
    }

    match /messages/{messageId} {
      allow read: if isSignedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      allow update: if false; // messages are immutable — no editing after sending
      allow delete: if isAdminUser(); // moderation only, never by either party
    }

    match /messageReports/{reportId} {
      // Only admins can read the queue — a reporter doesn't need to read
      // their own report back for anything the UI currently does.
      allow read: if isAdminUser();
      allow create: if isSignedIn() && request.resource.data.reporterUid == request.auth.uid;
      allow update: if isAdminUser() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdminUser();
    }

    match /studySets/{setId} {
      // Same low bar as classrooms — any signed-in user can read (students
      // need to see sets in classes they're in, and this avoids a per-class
      // membership check in rules). Only the owning teacher can write.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /homework/{homeworkId} {
      // Matches classrooms/studySets read bar so enrolled students and teachers
      // can query by classroomId without per-doc classroom membership lookups.
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.classroomId is string
        && request.resource.data.title is string;
      // Teachers can update their own assignments; students can submit/update
      // only their own entry inside the `variants` map (`variants.<uid>`).
      allow update: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variants']) &&
          request.resource.data.variants.diff(resource.data.get('variants', {})).affectedKeys().hasOnly([request.auth.uid])
        )
      );
      allow delete: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdminUser());
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      // Teachers create notifications for students (`recipientUid != auth.uid`).
      allow create: if isSignedIn()
        && request.resource.data.recipientUid is string
        && request.resource.data.type in ['homework', 'announcement', 'studyset', 'grade']
        && request.resource.data.title is string
        && request.resource.data.body is string
        && request.resource.data.read == false;
      allow update: if isSignedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if isSignedIn() && (resource.data.recipientUid == request.auth.uid || isAdminUser());
    }

    match /aiUsageLogs/{logId} {
      // Aggregate non-PII AI cost/cache telemetry readable by signed-in users
      // for the Cost & KPI Dashboard (matches progressSnapshots pattern).
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.task in ['chat', 'hint', 'stuck-help', 'quiz', 'study-set', 'course-outline', 'assessment', 'lab-coach']
        && request.resource.data.tier in ['nano', 'flash', 'pro']
        && request.resource.data.model is string
        && request.resource.data.promptTokens is number && request.resource.data.promptTokens >= 0
        && request.resource.data.completionTokens is number && request.resource.data.completionTokens >= 0
        && request.resource.data.totalTokens is number && request.resource.data.totalTokens >= 0
        && request.resource.data.estimatedUsd is number && request.resource.data.estimatedUsd >= 0
        && request.resource.data.cached is bool
        && request.resource.data.latencyMs is number && request.resource.data.latencyMs >= 0
        && request.resource.data.timestamp is string;
      allow update: if false;
      allow delete: if isAdminUser();
    }

    match /learningEvents/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.eventType in ['quiz_verified', 'lab_check_passed', 'circuit_verified']
        && request.resource.data.passed is bool
        && request.resource.data.timestamp is string
        && request.resource.data.weekKey is string
        && (!('score' in request.resource.data) || (request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100));
      allow update: if false;
      allow delete: if isAdminUser();
    }

    match /sessionLogs/{sessionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.dateKey is string
        && request.resource.data.weekKey is string
        && request.resource.data.startedAt is string
        && request.resource.data.durationMs is number && request.resource.data.durationMs >= 0;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.durationMs is number && request.resource.data.durationMs >= 0;
      allow delete: if isAdminUser();
    }

    match /labCompletions/{completionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.labId in ['light-circuit', 'night-light', 'distance-sensor', 'follow-path-robot', 'traffic-light']
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.checksPassed is number && request.resource.data.checksPassed >= 0
        && request.resource.data.checksTotal is number && request.resource.data.checksTotal > 0
        && request.resource.data.durationSec is number && request.resource.data.durationSec >= 0
        && request.resource.data.completedAt is string;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.labId == resource.data.labId
        && request.resource.data.score is number && request.resource.data.score >= 0 && request.resource.data.score <= 100
        && request.resource.data.checksPassed is number && request.resource.data.checksPassed >= 0
        && request.resource.data.checksTotal is number && request.resource.data.checksTotal > 0
        && request.resource.data.durationSec is number && request.resource.data.durationSec >= 0
        && request.resource.data.completedAt is string;
      allow delete: if isAdminUser();
    }
  }
}
