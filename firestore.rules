rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return request.auth.token.role == 'admin';
    }
    function isTeacher() {
      return request.auth.token.role == 'teacher';
    }

    match /classes/{classId} {
      // Read is open for now — adjust to your privacy policy
      allow read: if true;
      // Only signed-in teachers and admins may create classes
      allow create: if isSignedIn() && (isTeacher() || isAdmin());
      // Only admin may delete classes
      allow delete: if isAdmin();
      // Allow update if admin or the teacher who owns the class
      allow update: if isAdmin() || (isTeacher() && resource.data.teacherId == request.auth.uid);
    }

    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      // Users may update their own profile but cannot change role/verified fields
      allow update: if request.auth.uid == userId
         && !(request.resource.data.keys().hasAny(['role','verified']));
      // Admin may update any user (including role/verified)
      allow update: if isAdmin();
      allow create: if true;
    }

    match /recommendations/{recId} {
      allow create: if isTeacher() && request.auth.uid == request.resource.data.teacherId;
      allow read: if isAdmin() || request.auth.uid == request.resource.data.teacherId;
      allow update, delete: if isAdmin();
    }

    // Add other collections rules as needed
  }
}
