rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    // Admin status can only ever be set via the Firebase console (Admin SDK
    // bypasses these rules entirely) — there is deliberately no path here
    // for a client, even an existing admin, to grant isAdmin to anyone.
    function isAdminUser() {
      return isSignedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      // New accounts are never admin, regardless of what a crafted client
      // request claims — isAdmin can only be granted via the Firebase console.
      allow create: if isSelf(uid)
        && (!('isAdmin' in request.resource.data) || request.resource.data.isAdmin == false);
      // A user may update their own profile (name, bio, etc.) freely, but
      // never their role, tag, or admin flag.
      allow update: if isSelf(uid)
        && request.resource.data.role == resource.data.role
        && request.resource.data.studentTag == resource.data.studentTag
        && request.resource.data.get('isAdmin', false) == resource.data.get('isAdmin', false);
      // Only an admin can remove a profile outright, and never their own by
      // this path (self-deletion isn't something the admin panel offers).
      allow delete: if isAdminUser() && !isSelf(uid);
    }

    match /classrooms/{classroomId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      // Owner can edit anything; any signed-in user can only touch studentIds
      // (covers self-join on public classes and leaving/removal).
      allow update: if isSignedIn() && (
        resource.data.teacherId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['studentIds'])
      );
      allow delete: if isSignedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /invites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.studentUid == request.auth.uid || resource.data.teacherId == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.studentUid == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids;
      allow update: if isSignedIn(); // MVP: any signed-in user can update shared state
    }

    match /classSuggestions/{suggestionId} {
      allow read: if isSignedIn() && (resource.data.teacherId == request.auth.uid || isAdminUser());
      allow create: if isSignedIn()
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.status == 'new';
      allow update: if isAdminUser()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
    }
  }
}
